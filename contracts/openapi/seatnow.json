{
  "openapi": "3.0.3",
  "info": { "title": "SeatNow MVP API", "version": "0.1.0", "description": "Demo API. Venue, availability and parking data are fictional until a provider is connected." },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health": { "get": { "summary": "Check API and MongoDB readiness", "responses": { "200": { "description": "Ready" }, "503": { "description": "Database unavailable" } } } },
    "/auth/register": { "post": { "summary": "Register a demo user and set a session cookie", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterInput" } } } }, "responses": { "201": { "description": "Registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserEnvelope" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "409": { "description": "Email already registered" } } } },
    "/auth/login": { "post": { "summary": "Sign in and set a session cookie", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginInput" } } } }, "responses": { "200": { "description": "Signed in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserEnvelope" } } } }, "401": { "description": "Invalid credentials" } } } },
    "/auth/me": { "get": { "summary": "Read the current user", "security": [{ "sessionCookie": [] }], "responses": { "200": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserEnvelope" } } } }, "401": { "description": "Authentication required" } } } },
    "/auth/logout": { "post": { "summary": "Revoke the current session", "security": [{ "sessionCookie": [] }], "responses": { "204": { "description": "Session revoked" } } } },
    "/map/venues": { "get": { "summary": "Find venues near coordinates", "parameters": [
      { "$ref": "#/components/parameters/lat" }, { "$ref": "#/components/parameters/lng" },
      { "in": "query", "name": "radiusM", "schema": { "type": "integer", "minimum": 100, "maximum": 20000, "default": 3000 } },
      { "in": "query", "name": "category", "schema": { "type": "string", "enum": ["RESTAURANT", "CAFE", "CINEMA"] } },
      { "in": "query", "name": "cuisine", "schema": { "type": "string", "enum": ["VIETNAMESE", "WESTERN", "COFFEE", "DESSERT"] } },
      { "in": "query", "name": "priceTier", "schema": { "type": "integer", "minimum": 1, "maximum": 4 } },
      { "in": "query", "name": "ratingGte", "schema": { "type": "number", "minimum": 0, "maximum": 5 } },
      { "in": "query", "name": "crowdLevel", "schema": { "$ref": "#/components/schemas/CrowdLevel" } },
      { "in": "query", "name": "hasAvailability", "schema": { "type": "string", "enum": ["true", "false"] } },
      { "in": "query", "name": "adsHidden", "schema": { "type": "string", "enum": ["true", "false"], "description": "true requires a session with ads.hidden entitlement; sponsored ranking and promotion text are removed" } },
      { "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }
    ], "responses": { "200": { "description": "Nearby page; paid placement applies unless adsHidden is authorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenuePage" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "description": "Ad-free map requested without login" }, "403": { "description": "Ad-free map requested without Premium entitlement" } } } },
    "/map/search": { "get": { "summary": "Search published venues by name or address across all regions", "parameters": [{ "in": "query", "name": "q", "required": true, "schema": { "type": "string", "minLength": 2, "maxLength": 60 } }], "responses": { "200": { "description": "Up to 12 matches with a truncated flag", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" }, "address": { "type": "string" }, "category": { "type": "string" }, "location": { "$ref": "#/components/schemas/Point" }, "rating": { "type": "number" }, "priceTier": { "type": "integer" } } } }, "meta": { "type": "object", "properties": { "truncated": { "type": "boolean" } } } } } } } }, "400": { "$ref": "#/components/responses/ValidationError" } } } },
    "/venues/{slug}": { "get": { "summary": "Read an active venue profile", "parameters": [{ "$ref": "#/components/parameters/slug" }], "responses": { "200": { "description": "Venue profile and availability" }, "404": { "description": "Venue not found" } } } },
    "/venues/{slug}/availability": { "get": { "summary": "Read latest venue availability", "parameters": [{ "$ref": "#/components/parameters/slug" }], "responses": { "200": { "description": "Latest snapshot, including freshness", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Availability" } } } } } }, "404": { "description": "Venue not found" } } } },
    "/venues/{slug}/availability/history": { "get": { "summary": "Read the latest 10 availability snapshots captured in the past 24 hours", "parameters": [{ "$ref": "#/components/parameters/slug" }], "responses": { "200": { "description": "Availability records with freshness and truncation metadata" }, "404": { "description": "Venue not found" } } } },
    "/venues/{slug}/parking": { "get": { "summary": "Find linked and nearby parking", "parameters": [{ "$ref": "#/components/parameters/slug" }, { "$ref": "#/components/parameters/parkingFilters" }, { "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }], "responses": { "200": { "description": "Linked facilities first, then distance sorted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ParkingPage" } } } }, "404": { "description": "Venue not found" } } } },
    "/parking-facilities": { "get": { "summary": "Find parking near coordinates", "parameters": [{ "$ref": "#/components/parameters/lat" }, { "$ref": "#/components/parameters/lng" }, { "$ref": "#/components/parameters/parkingFilters" }, { "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }], "responses": { "200": { "description": "Distance sorted facilities", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ParkingPage" } } } }, "400": { "$ref": "#/components/responses/ValidationError" } } } },
    "/parking-facilities/{slug}": { "get": { "summary": "Read a parking facility", "parameters": [{ "$ref": "#/components/parameters/slug" }], "responses": { "200": { "description": "Parking detail" }, "404": { "description": "Facility not found" } } } },
    "/me/subscription": { "get": { "summary": "Read the current user plan", "security": [{ "sessionCookie": [] }], "responses": { "200": { "description": "Subscription state" }, "401": { "description": "Authentication required" } } } },
    "/me/entitlements": { "get": { "summary": "Read server resolved entitlements", "security": [{ "sessionCookie": [] }], "responses": { "200": { "description": "Free or Premium entitlements" }, "401": { "description": "Authentication required" } } } },
    "/internal/venues/{slug}/availability-snapshots": { "post": { "summary": "Ingest a venue availability snapshot", "security": [{ "ingestToken": [] }], "parameters": [{ "$ref": "#/components/parameters/slug" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AvailabilityInput" } } } }, "responses": { "201": { "description": "Snapshot accepted or deduplicated" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "description": "Missing or invalid ingest token" }, "404": { "description": "Venue not found" } } } },
    "/internal/parking-facilities/{slug}/availability-snapshots": { "post": { "summary": "Ingest a parking availability snapshot", "security": [{ "ingestToken": [] }], "parameters": [{ "$ref": "#/components/parameters/slug" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ParkingAvailabilityInput" } } } }, "responses": { "201": { "description": "Snapshot accepted or deduplicated" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "description": "Missing or invalid ingest token" }, "404": { "description": "Facility not found" } } } }
  },
  "components": {
    "securitySchemes": { "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "seatnow_sid", "description": "Production cookie is __Host-seatnow_sid." }, "ingestToken": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "lat": { "in": "query", "name": "lat", "required": true, "schema": { "type": "number", "minimum": -90, "maximum": 90 } },
      "lng": { "in": "query", "name": "lng", "required": true, "schema": { "type": "number", "minimum": -180, "maximum": 180 } },
      "slug": { "in": "path", "name": "slug", "required": true, "schema": { "type": "string" } },
      "cursor": { "in": "query", "name": "cursor", "schema": { "type": "string" } },
      "limit": { "in": "query", "name": "limit", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } },
      "parkingFilters": { "in": "query", "name": "radiusM", "description": "Parking radius; other filters: vehicleType (CAR/MOTORBIKE), open24h, freeOnly, hasAvailability.", "schema": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 1500 } }
    },
    "responses": { "ValidationError": { "description": "Invalid query, body or cursor", "content": { "application/json": { "schema": { "type": "object", "properties": { "statusCode": { "type": "integer" }, "code": { "type": "string" }, "message": { "type": "array", "items": { "type": "string" } } } } } } } },
    "schemas": {
      "CrowdLevel": { "type": "string", "enum": ["QUIET", "MODERATE", "BUSY", "FULL", "UNKNOWN"] },
      "Freshness": { "type": "string", "enum": ["FRESH", "STALE", "UNKNOWN"] },
      "Capacity": { "type": "object", "required": ["total", "available"], "properties": { "total": { "type": "integer", "minimum": 0 }, "available": { "type": "integer", "minimum": 0 } } },
      "Point": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "type": "string", "enum": ["Point"] }, "coordinates": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[longitude, latitude]" } } },
      "Availability": { "type": "object", "required": ["freshness", "crowdLevel"], "properties": { "freshness": { "$ref": "#/components/schemas/Freshness" }, "crowdLevel": { "$ref": "#/components/schemas/CrowdLevel" }, "tables": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/Capacity" }] }, "seats": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/Capacity" }] }, "estimatedWaitMinutes": { "type": "integer", "nullable": true }, "acceptingGuests": { "type": "boolean", "nullable": true }, "source": { "type": "string", "nullable": true }, "confidence": { "type": "number", "nullable": true }, "version": { "type": "integer", "nullable": true }, "capturedAt": { "type": "string", "format": "date-time", "nullable": true }, "expiresAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "VenuePage": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/VenueMapItem" } }, "meta": { "$ref": "#/components/schemas/PageMeta" } } },
      "VenueMapItem": { "type": "object", "required": ["id", "slug", "name", "category", "location", "distanceM", "availability"], "properties": { "id": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" }, "category": { "type": "string" }, "cuisineTypes": { "type": "array", "items": { "type": "string" } }, "address": { "type": "string" }, "location": { "$ref": "#/components/schemas/Point" }, "distanceM": { "type": "integer" }, "priceTier": { "type": "integer" }, "rating": { "type": "number" }, "availability": { "type": "object", "properties": { "freshness": { "$ref": "#/components/schemas/Freshness" }, "crowdLevel": { "$ref": "#/components/schemas/CrowdLevel" }, "tablesAvailable": { "type": "integer", "nullable": true }, "seatsAvailable": { "type": "integer", "nullable": true }, "estimatedWaitMinutes": { "type": "integer", "nullable": true } } } } },
      "ParkingPage": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/ParkingItem" } }, "meta": { "$ref": "#/components/schemas/PageMeta" } } },
      "ParkingItem": { "type": "object", "required": ["id", "slug", "name", "location", "distanceM", "pricing", "availability"], "properties": { "id": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" }, "address": { "type": "string" }, "location": { "$ref": "#/components/schemas/Point" }, "distanceM": { "type": "integer" }, "relation": { "type": "string", "enum": ["VENUE", "PARTNER", "PUBLIC"] }, "linkedToVenue": { "type": "boolean" }, "pricing": { "type": "object", "properties": { "kind": { "type": "string" }, "amountMinor": { "type": "integer", "nullable": true }, "currency": { "type": "string", "nullable": true }, "unit": { "type": "string", "nullable": true } } }, "availability": { "type": "object", "properties": { "availableSpaces": { "type": "integer", "nullable": true }, "totalSpaces": { "type": "integer", "nullable": true }, "freshness": { "$ref": "#/components/schemas/Freshness" }, "capturedAt": { "type": "string", "format": "date-time", "nullable": true } } } } },
      "PageMeta": { "type": "object", "required": ["nextCursor", "truncated", "queryCenter"], "properties": { "nextCursor": { "type": "string", "nullable": true }, "truncated": { "type": "boolean" }, "queryCenter": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } } } },
      "RegisterInput": { "type": "object", "required": ["email", "password", "displayName"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" }, "displayName": { "type": "string" } } },
      "LoginInput": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string", "format": "password" } } },
      "UserEnvelope": { "type": "object", "properties": { "data": { "type": "object", "properties": { "id": { "type": "string" }, "email": { "type": "string" }, "displayName": { "type": "string" }, "emailVerified": { "type": "boolean" } } } } },
      "AvailabilityInput": { "type": "object", "required": ["version", "crowdLevel", "acceptingGuests", "source", "sourceRecordId", "confidence", "capturedAt", "expiresAt"], "properties": { "version": { "type": "integer", "minimum": 1 }, "tables": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/Capacity" }] }, "seats": { "nullable": true, "allOf": [{ "$ref": "#/components/schemas/Capacity" }] }, "crowdLevel": { "$ref": "#/components/schemas/CrowdLevel" }, "estimatedWaitMinutes": { "type": "integer", "nullable": true }, "acceptingGuests": { "type": "boolean" }, "source": { "type": "string", "enum": ["DEMO", "OPERATOR", "POS"] }, "sourceRecordId": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "capturedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "ParkingAvailabilityInput": { "type": "object", "required": ["version", "source", "sourceRecordId", "confidence", "capturedAt", "expiresAt"], "properties": { "version": { "type": "integer", "minimum": 1 }, "availableSpaces": { "type": "integer", "nullable": true }, "totalSpaces": { "type": "integer", "nullable": true }, "source": { "type": "string", "enum": ["DEMO", "OPERATOR", "SENSOR"] }, "sourceRecordId": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "capturedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" } } }
    }
  }
}
